# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Neo4j Connection
NEO4J_URI=bolt://localhost:7687

# LLM Configuration
# Provider: anthropic
# Query Planner sử dụng model nhẹ để tối ưu token
# Answer Generator sử dụng model mạnh hơn cho output chất lượng cao
LLM_PROVIDER=anthropic
LLM_MODEL_PLANNER=claude-haiku-4-5-20251001
LLM_MODEL_GENERATOR=claude-sonnet-4-6
LLM_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM mode cho retrieval/demo: claude (thuần) | claude-fallback (Claude+Gemini khi
# drop) | gemini (end-to-end) | gemini-fallback (Gemini+Claude khi 429/5xx — demo
# bảo vệ, D-26). Env này chỉ là default khi gọi make_llm_client(mode=None); mọi lệnh
# trong README đều truyền --llm-mode tường minh nên nó không đụng tới số đã công bố.
# ĐỂ `gemini`: toàn bộ số liệu của báo cáo đo bằng Gemini (Bảng 3.6 — planner 2.5
# Flash, generator 2.5 Pro), và UI `DEMO_MODE=live` đọc đúng biến này. Đặt `claude`
# ở đây là demo trước hội đồng bằng một nhà cung cấp khác cái đang trình bày.
LLM_MODE=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PLANNER=gemini-2.5-flash
GEMINI_MODEL_GENERATOR=gemini-2.5-pro   # Vertex: 2.5-pro thắng bake-off (gần Claude); 3.x-flash/preview kém hơn
# GEMINI_USE_VERTEX=true → gọi Vertex AI qua ADC (dùng credit Cloud/$300 trial) thay vì
# Developer API. Vertex KHÔNG nhận api_key → cần `gcloud auth application-default login`.
# Bật khi vùng không có free tier Developer API. Cần khai project + location.
GEMINI_USE_VERTEX=false
GEMINI_VERTEX_PROJECT=your-gcp-project-id
GEMINI_VERTEX_LOCATION=us-central1

# Embedding Configuration
# ⚠ KHÔNG CÓ TÁC DỤNG — không code nào đọc biến này. `load_model()` trong
# src/ingestion/vectorizer.py hardcode mặc định "BAAI/bge-m3". Giữ lại chỉ để
# ghi nhận model đang dùng; đổi giá trị ở đây KHÔNG đổi model.
# EMBEDDING_MODEL=BAAI/bge-m3

# ── Tùy chọn nâng cao (mặc định trong code, chỉ bật khi cần) ──
# LLM_TEMPERATURE=0.0        # nhiệt độ generator (answer_generator.py, mặc định 0)
# ⚠ INGEST_LLM_MODE KHÔNG CÒN TÁC DỤNG — Pass 4 (ontology mapping) luôn chạy Gemini
#   Flash theo GEMINI_MODEL_PLANNER, không đi qua make_llm_client nữa.
# INCLUDE_SCHEMA_B=false     # bật block schema B trong context_assembler (thí nghiệm)
# RERANKER_DEVICE=cpu        # thiết bị cross-encoder reranker (cpu — MPS treo, D-20)

# ── UI demo bảo vệ (ui/, ui/docs/UI_DEMO_SPEC.md) ──
DEMO_MODE=replay             # replay (phát lại fixture, không cần DB) | live (gọi run_pipeline thật)
# ⚠ UI_PORT KHÔNG CÓ TÁC DỤNG — không code nào đọc. Cổng đặt bằng cờ dòng lệnh:
#   uvicorn ui.server:app --port 8000
# UI_PORT=8000
REPLAY_SPEED=4.0             # hệ số tua nhanh khi phát lại (t thật / REPLAY_SPEED)
# DEMO_DEVMODE — ĐỂ NGUYÊN DẠNG COMMENT. Bật lên thì chế độ `live` chỉ là GIẢ LẬP
# bằng fixture: trang hiện badge TRỰC TIẾP trong khi KHÔNG hề gọi Neo4j/Qdrant/LLM.
# Chỉ dùng để dựng giao diện ở máy không có DB, và nên bật bằng cờ dòng lệnh
# (`python -m ui.run --devmode`) thay vì viết vào .env — viết vào đây thì
# `uvicorn ui.server:app` trần cũng dính, vì server gọi load_dotenv().
# scripts/preflight.py báo LỖI CHẶN nếu biến này còn bật.
# DEMO_DEVMODE=1
