data/sources/*.pdf
data/sources/*.docx

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Test / Coverage
.pytest_cache/
htmlcov/
.coverage

# LLM cache cho eval (large, ephemeral, sinh ra khi chạy run_evaluation)
data/evaluation/.llm_cache/