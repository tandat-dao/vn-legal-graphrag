# Environment
.env
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Docker volumes (data persisted locally, not in git)
data/neo4j/
data/qdrant/
# Store cũ đổi tên khi reset DB (xóa tay khi chắc chắn không cần)
data/neo4j.bak/
data/qdrant.bak/

# HTML thô lưu tay từ vbpl.vn (Ctrl+S, ~52MB) — nguồn tái tải được; thứ cần track
# là markdown sinh ra ở data/raw/. Cùng tinh thần với data/sources/*.pdf bên dưới.
data/raw_html/
# Báo cáo soát tay do scripts/html_to_markdown.py sinh lại mỗi lần chạy
data/raw/TODO_review.md
# Báo cáo sơ bộ nội bộ theo phiên làm việc
docs/bao-cao-so-bo-*.md

# Source documents (PDF/DOCX) — lưu cục bộ, không commit lên git
# manifest.md vẫn được track để có audit trail
data/sources/*.pdf
data/sources/*.docx

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Test / Coverage
.pytest_cache/
htmlcov/
.coverage

# LLM cache cho eval (large, ephemeral, sinh ra khi chạy run_evaluation)
data/evaluation/.llm_cache/

# Query planner cache (sinh ra khi chạy demo CLI / pipeline — runtime only)
data/evaluation/.planner_cache/

# Rác sinh do relative path khi chạy notebook từ thư mục notebooks/
# (query_planner dùng Path("data/...") → tạo notebooks/data/.planner_cache/)
notebooks/data/

# Output thử nghiệm eval nháp (sanity/bake-off/subset — số liệu đã ghi Decision Log)
# Kết quả canonical (vd gemini_full26/) vẫn được commit tường minh.
data/evaluation/_sub*
data/evaluation/sanity_*
data/evaluation/bakeoff/
# Kết quả nhiễm 429 + dev-subset runs — giữ local, không commit (xem README trong folder)
data/evaluation/quarantine_429/*
!data/evaluation/quarantine_429/README.md
data/evaluation/dev_runs/*
!data/evaluation/dev_runs/README.md

# Đánh giá con người E2C — repo này PUBLIC. E2C_KEY.json là khóa giải ẩn danh
# (ánh xạ mã câu → hệ nào sinh câu trả lời); công khai là phá tính ẩn danh của
# thí nghiệm và cho phép truy ngược điểm của từng người chấm.
data/evaluation/e2c/

# Bản nháp báo cáo khóa luận — không commit lên repo công khai. Ngoài lý do
# bản quyền, bản nháp nằm public còn có thể bị Turnitin quét trúng và báo
# trùng lặp với chính bài của mình.
docs/thesis/
docs/report.md
docs/FT_SYNTHESIS_D_DIENGIAI.md
docs/presentation

# Finetune (TASK-FT-*): weights GGUF/LoRA + dataset sinh ra — nặng, tái tạo được
# bằng code trong finetune/. Report + notebook + kết quả JSON vẫn được commit.
finetune/models/
finetune/data/*.jsonl
# File dở dang của replay.py (--resume đọc lại) + đầu ra mock khi verify schema
finetune/results/*.partial.jsonl
finetune/results/*_mock_*.json
# Log của hai luồng --parallel (FT-06). Trên Kaggle chúng nằm ở /kaggle/working;
# ngoài Kaggle thì LOG_DIR lùi về finetune/results/. Nội dung đã được in gộp vào
# output notebook nên không cần commit.
finetune/results/*.log

# Tài liệu nội bộ, không đưa lên repo công khai
docs/Instruction.md

# Bản sao do đồng bộ đám mây sinh ra
* 2.*
*.sync-conflict-*
* 2
